# Schedula Backend Environment Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=["*"]

# Firebase Admin SDK
# Keep the JSON service-account file OUTSIDE Git and set this to its local path.
# Windows example:
# FIREBASE_CREDENTIALS_PATH=C:\\path\\to\\firebase-service-account.json
# macOS/Linux example:
# FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=
